# ── JWT / Authentification (backend) ───────────────────────
JWT_SECRET=remplacez-par-une-chaine-aleatoire-longue
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Compte créé automatiquement si aucun utilisateur n'existe
INIT_ADMIN_EMAIL=admin@automl.local
INIT_ADMIN_PASSWORD=admin123

# true = désactive JWT (développement uniquement)
AUTH_DISABLED=false

# ── MLflow ─────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_MAX_RUNS=20
MLFLOW_MAX_MODEL_VERSIONS=3
MLFLOW_REGISTER_MODELS=false

# ── CORS (si le front n'est pas sur :3000 / :3001) ─────────
# CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# ── Frontend (optionnel) ───────────────────────────────────
# REACT_APP_API_URL=http://localhost:8000

# ── Protection des données ─────────────────────────────────
# Clé secrète Fernet pour le chiffrement des datasets (générée automatiquement si absente)
# DATA_ENCRYPTION_KEY=
# Taille maximale autorisée pour l'upload (en octets, par défaut 52428800 = 50 Mo)
# MAX_UPLOAD_SIZE=52428800

